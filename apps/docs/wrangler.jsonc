{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ds-platform-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Gateway credentials are secrets, never vars — never committed here.
  // Set with, one at a time:
  //   wrangler secret put CF_AI_GATEWAY_ACCOUNT_ID
  //   wrangler secret put CF_AI_GATEWAY_ID
  //   wrangler secret put CF_AI_GATEWAY_TOKEN
  //   wrangler secret put DS_MODEL
  // For local dev, put the same four in a .dev.vars file (gitignored) instead.
}
