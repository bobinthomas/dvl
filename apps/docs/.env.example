# Copy to .env.local (gitignored) and fill in — used by `pnpm dev`'s local
# dev-only API (Wizard's Scan/doc-check/promote steps, and Verify). This is
# separate from .dev.vars, which is only read by `wrangler dev` / a real
# deploy for the /api/ask route.
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=
DS_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Only needed for the Wizard's "Verify" step (Figma REST reconciliation).
FIGMA_ACCESS_TOKEN=
