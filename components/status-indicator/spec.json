{
  "id": "status-indicator",
  "name": "StatusIndicator",
  "category": "feedback",
  "status": "draft",
  "version": "1.0.0",
  "owner": "product team",
  "description": "A standardized status indicator to provide visual cues for ongoing actions, such as saving, loading, or processing, to keep users informed about the progress of their requests.",
  "anatomy": {
    "root": "status-indicator",
    "parts": [
      {
        "name": "icon",
        "description": "The icon representing the status",
        "optional": false
      },
      {
        "name": "label",
        "description": "The text label describing the status",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "enum",
      "description": "The variant of the status indicator",
      "required": true,
      "platforms": [
        "react",
        "react-native"
      ],
      "values": [
        "primary",
        "success",
        "error",
        "loading",
        "warning"
      ]
    },
    {
      "name": "size",
      "type": "enum",
      "description": "The size of the status indicator",
      "required": false,
      "platforms": [
        "react",
        "react-native"
      ],
      "values": [
        "small",
        "medium",
        "large"
      ]
    }
  ],
  "states": [
    "default",
    "loading"
  ],
  "invalidCombinations": [
    {
      "state": "loading",
      "variant": "success"
    },
    {
      "state": "loading",
      "variant": "error"
    }
  ],
  "tokens": [
    {
      "part": "root",
      "when": {},
      "properties": {
        "borderRadius": "{radius.pill}",
        "paddingBlock": "{spacing.xs}",
        "paddingInline": "{spacing.md}"
      }
    },
    {
      "part": "root",
      "when": { "variant": "primary" },
      "properties": { "backgroundColor": "{color.status.primary.bg}" }
    },
    {
      "part": "root",
      "when": { "variant": "success" },
      "properties": { "backgroundColor": "{color.status.success.bg}" }
    },
    {
      "part": "root",
      "when": { "variant": "error" },
      "properties": { "backgroundColor": "{color.status.error.bg}" }
    },
    {
      "part": "root",
      "when": { "variant": "warning" },
      "properties": { "backgroundColor": "{color.status.warning.bg}" }
    },
    {
      "part": "root",
      "when": { "variant": "loading" },
      "properties": { "backgroundColor": "{color.status.loading.bg}" }
    },
    {
      "part": "icon",
      "when": { "variant": "primary" },
      "properties": { "color": "{color.status.primary.fg}", "size": "{fontSize.sm}" }
    },
    {
      "part": "icon",
      "when": { "variant": "success" },
      "properties": { "color": "{color.status.success.fg}", "size": "{fontSize.sm}" }
    },
    {
      "part": "icon",
      "when": { "variant": "error" },
      "properties": { "color": "{color.status.error.fg}", "size": "{fontSize.sm}" }
    },
    {
      "part": "icon",
      "when": { "variant": "warning" },
      "properties": { "color": "{color.status.warning.fg}", "size": "{fontSize.sm}" }
    },
    {
      "part": "icon",
      "when": { "variant": "loading" },
      "properties": { "color": "{color.status.loading.fg}", "size": "{fontSize.sm}" }
    },
    {
      "part": "label",
      "when": { "variant": "primary" },
      "properties": { "color": "{color.status.primary.fg}", "fontSize": "{fontSize.sm}" }
    },
    {
      "part": "label",
      "when": { "variant": "success" },
      "properties": { "color": "{color.status.success.fg}", "fontSize": "{fontSize.sm}" }
    },
    {
      "part": "label",
      "when": { "variant": "error" },
      "properties": { "color": "{color.status.error.fg}", "fontSize": "{fontSize.sm}" }
    },
    {
      "part": "label",
      "when": { "variant": "warning" },
      "properties": { "color": "{color.status.warning.fg}", "fontSize": "{fontSize.sm}" }
    },
    {
      "part": "label",
      "when": { "variant": "loading" },
      "properties": { "color": "{color.status.loading.fg}", "fontSize": "{fontSize.sm}" }
    }
  ],
  "accessibility": {
    "role": "status",
    "keyboard": {},
    "aria": [
      {
        "attribute": "aria-label",
        "condition": "label is present"
      }
    ],
    "contrast": [
      {
        "part": "icon",
        "foreground": "{color.status.primary.fg}",
        "background": "{color.status.primary.bg}",
        "minRatio": 4.5
      },
      {
        "part": "icon",
        "foreground": "{color.status.success.fg}",
        "background": "{color.status.success.bg}",
        "minRatio": 4.5
      },
      {
        "part": "icon",
        "foreground": "{color.status.error.fg}",
        "background": "{color.status.error.bg}",
        "minRatio": 4.5
      },
      {
        "part": "icon",
        "foreground": "{color.status.warning.fg}",
        "background": "{color.status.warning.bg}",
        "minRatio": 4.5
      },
      {
        "part": "icon",
        "foreground": "{color.status.loading.fg}",
        "background": "{color.status.loading.bg}",
        "minRatio": 4.5
      },
      {
        "part": "label",
        "foreground": "{color.status.primary.fg}",
        "background": "{color.status.primary.bg}",
        "minRatio": 4.5
      },
      {
        "part": "label",
        "foreground": "{color.status.success.fg}",
        "background": "{color.status.success.bg}",
        "minRatio": 4.5
      },
      {
        "part": "label",
        "foreground": "{color.status.error.fg}",
        "background": "{color.status.error.bg}",
        "minRatio": 4.5
      },
      {
        "part": "label",
        "foreground": "{color.status.warning.fg}",
        "background": "{color.status.warning.bg}",
        "minRatio": 4.5
      },
      {
        "part": "label",
        "foreground": "{color.status.loading.fg}",
        "background": "{color.status.loading.bg}",
        "minRatio": 4.5
      }
    ],
    "requirements": []
  },
  "examples": [
    {
      "name": "Loading status indicator",
      "description": "A status indicator showing a loading state",
      "props": {
        "variant": "loading",
        "size": "medium"
      },
      "state": "loading"
    },
    {
      "name": "Success status indicator",
      "description": "A status indicator showing a success state",
      "props": {
        "variant": "success",
        "size": "small"
      },
      "state": "default"
    },
    {
      "name": "Primary status indicator",
      "description": "A status indicator showing the primary state, large size",
      "props": {
        "variant": "primary",
        "size": "large"
      },
      "state": "default"
    },
    {
      "name": "Error status indicator",
      "description": "A status indicator showing an error state",
      "props": {
        "variant": "error"
      },
      "state": "default"
    },
    {
      "name": "Warning status indicator",
      "description": "A status indicator showing a warning state",
      "props": {
        "variant": "warning"
      },
      "state": "default"
    }
  ],
  "overrides": {
    "imports": []
  }
}
