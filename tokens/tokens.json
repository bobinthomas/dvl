{
  "color": {
    "brand": {
      "blue": {
        "100": { "$value": "#E6EEFF", "$type": "color" },
        "500": { "$value": "#0052CC", "$type": "color" },
        "600": { "$value": "#003D99", "$type": "color" }
      },
      "neutral": {
        "0": { "$value": "#FFFFFF", "$type": "color" },
        "100": { "$value": "#F4F5F7", "$type": "color" },
        "300": { "$value": "#DFE1E6", "$type": "color" },
        "500": { "$value": "#6B778C", "$type": "color" },
        "700": { "$value": "#42526E", "$type": "color" },
        "900": { "$value": "#172B4D", "$type": "color" }
      }
    },
    "status": {
      "primary": {
        "fg": { "$value": "#1D4ED8", "$type": "color" },
        "bg": { "$value": "#EFF6FF", "$type": "color" }
      },
      "success": {
        "fg": { "$value": "#15803D", "$type": "color" },
        "bg": { "$value": "#F0FDF4", "$type": "color" }
      },
      "error": {
        "fg": { "$value": "#B91C1C", "$type": "color" },
        "bg": { "$value": "#FEF2F2", "$type": "color" }
      },
      "warning": {
        "fg": { "$value": "#B45309", "$type": "color" },
        "bg": { "$value": "#FFFBEB", "$type": "color" }
      },
      "loading": {
        "fg": { "$value": "#475569", "$type": "color" },
        "bg": { "$value": "#F1F5F9", "$type": "color" }
      }
    },
    "action": {
      "primary": {
        "default": {
          "bg": { "$value": "{color.brand.blue.500}", "$type": "color" },
          "fg": { "$value": "{color.brand.neutral.0}", "$type": "color" }
        },
        "hover": {
          "bg": { "$value": "{color.brand.blue.600}", "$type": "color" }
        },
        "disabled": {
          "bg": { "$value": "{color.brand.neutral.300}", "$type": "color" },
          "fg": { "$value": "{color.brand.neutral.500}", "$type": "color" }
        }
      },
      "secondary": {
        "default": {
          "bg": { "$value": "{color.brand.neutral.0}", "$type": "color" },
          "fg": { "$value": "{color.brand.blue.500}", "$type": "color" },
          "border": { "$value": "{color.brand.blue.500}", "$type": "color" }
        },
        "hover": {
          "bg": { "$value": "{color.brand.blue.100}", "$type": "color" }
        }
      },
      "tertiary": {
        "default": {
          "fg": { "$value": "{color.brand.blue.500}", "$type": "color" }
        },
        "hover": {
          "fg": { "$value": "{color.brand.blue.600}", "$type": "color" }
        }
      }
    }
  },
  "spacing": {
    "xs": { "$value": "6px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" }
  },
  "fontSize": {
    "sm": { "$value": "13px", "$type": "dimension" },
    "md": { "$value": "14px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" }
  },
  "radius": {
    "md": { "$value": "6px", "$type": "dimension" },
    "pill": { "$value": "16px", "$type": "dimension" }
  }
}
