{
  "name": "ds-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ds": "node --import tsx packages/cli/src/index.ts",
    "validate": "pnpm ds validate",
    "build": "pnpm ds build",
    "schema:emit": "node --import tsx packages/core/src/emit-json-schema.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ds-platform/core": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "jsdom": "^25.0.1",
    "react-native-web": "^0.19.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}
